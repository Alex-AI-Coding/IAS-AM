# Optional: enables VirusTotal hash reputation in the desktop Settings page.
VIRUSTOTAL_API_KEY=

# Optional: override the default project-local antivirus_data directory.
# ANTIVIRUS_DATA_DIR=C:\path\to\ias-defender-data

# The desktop app works without the API. Scanning API routes fail closed until
# a long, random Bearer token is configured. Generate one using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ANTIVIRUS_API_TOKEN=
# API requests may only reference this directory (relative to the launch folder).
ANTIVIRUS_API_SCAN_ROOT=demo_samples

# Optional positive resource limits (bytes, file entries, seconds).
# ANTIVIRUS_MAX_FILE_BYTES=268435456
# ANTIVIRUS_MAX_SCAN_FILES=25000
# ANTIVIRUS_YARA_TIMEOUT=10
